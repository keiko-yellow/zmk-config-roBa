#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/*
 * レイヤー番号
 *
 * 0 = default_layout
 * 1 = sign_num
 * 2 = layer_bt_sel0_4
 * 3 = no
 * 4 = mouse
 * 5 = arrow
 */

#define BASE 0
#define MOUSE 4
#define SCROLL 5
#define NUM 1

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    /*
     * トラックボールを動かす
     * → レイヤー4を有効化
     *
     * トラックボールを止める
     * → 30秒後にレイヤー4を解除
     *
     * MB1～MB5を出すために使用する物理キーだけは、
     * 押してもオートマウスレイヤーを解除しない。
     *
     * 6・7・8 = MB4 / MB5コンボに使用
     * 18・19 = MB1 / MB2の単打、およびMB3コンボに使用
     *
     * それ以外のキーを押すと、
     * クリック後であってもオートマウスレイヤーを即時解除する。
     *
     * T位置（18）はMOUSEレイヤー中はMB1、N位置（19）はMB2。
     * クリック用途としてレイヤーを維持する。通常入力時は、
     * マウス用コンボをMOUSE限定にしたため待ち時間が発生しない。
     */

    motion_threshold: motion_threshold {
        compatible = "zmk,input-processor-motion-threshold";
        #input-processor-cells = <1>;

        /*
         * X/Yの累積移動量が30に達するまで、
         * 後段の標準オートマウスへイベントを渡さない。
         */

        threshold = <500>;

        /*
         * 200ms動かなければ累積移動量を0へ戻す。
         */

        reset-timeout-ms = <200>;
    };

    auto_mouse_layer: auto_mouse_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;

        /*
         * MB1～MB5に使うW・R・Y・T・Nと、
         * Ctrlクリックに使う左右Ctrl位置はマウスレイヤーを維持。
         * それ以外のキーを押すと即通常レイヤーへ戻る。
         */

        excluded-positions = <6 7 8 10 18 19 21>;
    };

    combos {
        compatible = "zmk,combos";

        /*
         * すべてのコンボ判定を80msに統一。
         * MB3はMOUSEレイヤー限定。
         * MB4・MB5は数字レイヤー以外で有効。
         * 文字コンボは全レイヤーで有効。
         */
        /*
         * MOUSEレイヤーでは、T位置（18）の単打がMB1、
         * N位置（19）の単打がMB2。
         * MB3～MB5だけをコンボで出す。
         */

        mb3 {
            bindings = <&mkp MB3>;
            key-positions = <18 19>;
            timeout-ms = <80>;
            layers = <MOUSE>;
        };

        /*
         * W + R → MB4
         * 数字レイヤーでは7 + 8 → *を優先する。
         */

        mb4 {
            bindings = <&mkp MB4>;
            key-positions = <6 7>;
            timeout-ms = <80>;
            layers = <0 2 3 4 5>;
        };

        /*
         * R + Y → MB5
         * 数字レイヤーでは8 + 9 → /を優先する。
         */

        mb5 {
            bindings = <&mkp MB5>;
            key-positions = <7 8>;
            timeout-ms = <80>;
            layers = <0 2 3 4 5>;
        };

        left {
            bindings = <&kp LEFT_ARROW>;
            key-positions = <11 12>;
            timeout-ms = <80>;
        };

        right {
            bindings = <&kp RIGHT_ARROW>;
            key-positions = <12 13>;
            timeout-ms = <80>;
        };

        up {
            bindings = <&kp UP_ARROW>;
            key-positions = <1 2>;
            timeout-ms = <80>;
        };

        down {
            bindings = <&kp DOWN_ARROW>;
            key-positions = <23 24>;
            timeout-ms = <80>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <1 0>;
            timeout-ms = <80>;
        };

        del2 {
            bindings = <&kp ESCAPE>;
            key-positions = <8 9>;
            timeout-ms = <80>;
        };

        /*
         * C + V → 左単語削除
         * Ctrl + Backspace
         */

        cv_ctrl_backspace {
            bindings = <&kp LC(BACKSPACE)>;
            key-positions = <24 25>;
            timeout-ms = <80>;
        };

        /*
         * D + M → 右単語削除
         * Ctrl + Delete
         * 全レイヤーで有効。
         */

        dm_ctrl_delete {
            bindings = <&kp LC(DELETE)>;
            key-positions = <30 31>;
            timeout-ms = <80>;
        };

        /*
         * S + H → 半角／全角
         *
         * 元設定で同じ20・21に存在したDeleteコンボは削除し、
         * 競合しないようにしている。
         */

        hankaku {
            bindings = <&kp GRAVE>;
            key-positions = <20 21>;
            timeout-ms = <80>;
        };

        /*
         * E + I → F10
         * Mod-Tapキーを含むため長めに判定。
         */

        ei_f10 {
            bindings = <&kp F10>;
            key-positions = <10 11>;
            timeout-ms = <80>;
        };

        /* Z + X → F7 */

        zx_f7 {
            bindings = <&kp F7>;
            key-positions = <22 23>;
            timeout-ms = <80>;
        };

        /* X + V → Home */

        xv_home {
            bindings = <&kp HOME>;
            key-positions = <23 25>;
            timeout-ms = <80>;
        };

        /* I + O → Windows音声入力（Win + H） */

        io_win_h {
            bindings = <&kp LG(H)>;
            key-positions = <11 13>;
            timeout-ms = <80>;
        };

        /*
         * M + J → Delete
         * Keyball44で長めに設定されているコンボ。
         * 全レイヤーで有効。
         */

        mj_delete {
            bindings = <&kp DELETE>;
            key-positions = <31 32>;
            timeout-ms = <80>;
        };

        /* D + J → End */

        dj_end {
            bindings = <&kp END>;
            key-positions = <30 32>;
            timeout-ms = <80>;
        };

        /*
         * 数字レイヤー専用コンボ
         *
         * Windows日本語配列で出る記号：
         * 4 + 6 → =
         * 7 + 8 → *
         * 8 + 9 → /
         * 4 + 5 → +
         * 5 + 6 → -
         */
        /* 4 + 6 → = */

        num_46_equal {
            bindings = <&kp UNDER>;
            key-positions = <18 20>;
            timeout-ms = <80>;
            layers = <NUM>;
        };

        /* 7 + 8 → * */

        num_78_multiply {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <6 7>;
            timeout-ms = <80>;
            layers = <NUM>;
        };

        /* 8 + 9 → / */

        num_89_divide {
            bindings = <&kp SLASH>;
            key-positions = <7 8>;
            timeout-ms = <80>;
            layers = <NUM>;
        };

        /* 4 + 5 → + */

        num_45_plus {
            bindings = <&kp COLON>;
            key-positions = <18 19>;
            timeout-ms = <80>;
            layers = <NUM>;
        };

        /* 5 + 6 → - */

        num_56_minus {
            bindings = <&kp MINUS>;
            key-positions = <19 20>;
            timeout-ms = <80>;
            layers = <NUM>;
        };

        f4 {
            bindings = <&kp F4>;
            key-positions = <32 33>;
            timeout-ms = <80>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * Layer 0
         * 現在のroBa通常レイヤーを変更しない。
         */

        default_layout {
            bindings = <
&kp Q               &kp L           &kp U        &kp COMMA  &kp DOT                                                 &kp F                  &kp W  &kp R  &kp Y  &kp P
&mt LCTRL E         &mt LEFT_ALT I  &kp A        &kp O      &kp MINUS         &kp PRINTSCREEN      &kp F15          &kp K                  &kp T  &kp N  &kp S  &mt RCTRL H
&mt LEFT_WIN Z      &kp X           &kp C        &kp V      &kp LEFT_BRACKET  &kp F2               &kp LANG2        &kp G                  &kp D  &kp M  &kp J  &mt LEFT_WIN B
&kp LG(LS(ESCAPE))  &kp LS(HOME)    &kp LS(END)  &lt 1 TAB  &mt LSHIFT SPACE  &lt 3 ESCAPE         &lt 1 BACKSPACE  &mt RIGHT_SHIFT ENTER                       &lt 2 GRAVE
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        /*
         * Layer 1
         */

        sign_num {
            bindings = <
&kp AT_SIGN    &kp LS(INT1)  &kp QUESTION     &kp UP_ARROW        &kp ASTERISK                                             &kp COMMA   &kp N7  &kp N8  &kp N9  &kp LS(NUMBER_4)
&kp SQT        &kp MINUS     &kp CARET        &kp LS(LEFT_ARROW)  &kp RIGHT_ARROW       &kp LS(ASTRK)      &kp UNDERSCORE  &kp N0      &kp N4  &kp N5  &kp N6  &kp LS(N5)
&kp HASH       &kp PLUS      &kp EXCLAMATION  &kp DOWN_ARROW      &kp LEFT_PARENTHESIS  &trans             &kp KP_NUMLOCK  &kp PERIOD  &kp N1  &kp N2  &kp N3  &kp INTERNATIONAL_3
&kp SEMICOLON  &kp EQUAL     &trans           &kp LG(D)           &kp LEFT_WIN          &trans             &trans          &trans                              &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        /*
         * Layer 2
         */

        layer_bt_sel0_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                              &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans          &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans          &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &bt BT_CLR_ALL  &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        /*
         * Layer 3
         */

        no {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans   &kp F7  &kp F8  &kp F9  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp F10  &kp F4  &kp F5  &kp F6  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans   &kp F1  &kp F2  &kp F3  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                           &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        /*
         * Layer 4
         * オートマウスレイヤー
         */

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                              &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        /*
         * Layer 5
         */

        arrow {
            bindings = <
&trans  &trans  &kp SPACE  &mmv MOVE_UP    &mkp MB1                             &trans        &kp LC(LEFT_ARROW)  &kp UP_ARROW      &kp LC(RIGHT_ARROW)  &trans
&trans  &trans  &trans     &mmv MOVE_LEFT  &mmv MOVE_RIGHT  &trans      &trans  &kp LC(PLUS)  &kp LEFT_ARROW      &mkp MB3          &kp RIGHT_ARROW      &trans
&trans  &trans  &trans     &mmv MOVE_DOWN  &mkp MB2         &trans      &trans  &trans        &kp LC(KP_MINUS)    &kp LC(UP_ARROW)  &kp DOWN_ARROW       &kp LC(DOWN_ARROW)
&trans  &trans  &trans     &trans          &trans           &trans      &trans  &trans                                                                   &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };
    };

    /*
     * 通常時：
     * 累積移動量30に達したイベントだけを標準オートマウスへ渡し、MOUSEレイヤー（4）を有効化する。
     * 最後のトラックボール入力から30秒後に自動解除する。
     *
     * MB1～MB5以外の物理キーを押した場合は、
     * 30秒を待たずに即時解除する。
     *
     * sign_num（レイヤー1）を有効にしている間：
     * トラックボールのX/Y移動を横・縦スクロールへ変換する。
     * sign_numは現在の &lt 1 TAB または &lt 1 BACKSPACE の
     * 長押しで有効になる。
     */

    trackball_listener {
        status = "okay";
        input-processors = <
            &motion_threshold MOUSE
            &zip_xy_scaler 9 10
            &auto_mouse_layer MOUSE 0
        >;

        sign_num_scroll {
            layers = <1>;
            input-processors = <
                &zip_xy_to_scroll_mapper
                &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
                &zip_scroll_scaler 1 8
            >;
        };
    };
};
