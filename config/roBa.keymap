#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/*
 * レイヤー番号
 * 0 = default_layout
 * 1 = sign_num
 * 2 = layer_bt_sel0_4
 * 3 = no
 * 4 = mouse
 * 5 = arrow
 */

#define BASE 0
#define NUM 1
#define MOUSE 4
#define SCROLL 5

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        mb3 {
            bindings = <&mkp MB3>;
            key-positions = <18 19>;
            timeout-ms = <80>;
            layers = <MOUSE>;
        };

        mb4 {
            bindings = <&mkp MB4>;
            key-positions = <6 7>;
            timeout-ms = <80>;
            layers = <0 2 3 4 5>;
        };

        mb5 {
            bindings = <&mkp MB5>;
            key-positions = <7 8>;
            timeout-ms = <80>;
            layers = <0 2 3 4 5>;
        };

        left {
            bindings = <&kp LEFT_ARROW>;
            key-positions = <11 12>;
            timeout-ms = <80>;
        };

        right {
            bindings = <&kp RIGHT_ARROW>;
            key-positions = <12 13>;
            timeout-ms = <80>;
        };

        up {
            bindings = <&kp UP_ARROW>;
            key-positions = <1 2>;
            timeout-ms = <80>;
        };

        down {
            bindings = <&kp DOWN_ARROW>;
            key-positions = <23 24>;
            timeout-ms = <80>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <1 0>;
            timeout-ms = <80>;
        };

        del2 {
            bindings = <&kp ESCAPE>;
            key-positions = <8 9>;
            timeout-ms = <80>;
        };

        cv_ctrl_backspace {
            bindings = <&kp LC(BACKSPACE)>;
            key-positions = <24 25>;
            timeout-ms = <80>;
        };

        dm_ctrl_delete {
            bindings = <&kp LC(DELETE)>;
            key-positions = <30 31>;
            timeout-ms = <80>;
        };

        hankaku {
            bindings = <&kp GRAVE>;
            key-positions = <20 21>;
            timeout-ms = <80>;
        };

        ei_f10 {
            bindings = <&kp F10>;
            key-positions = <10 11>;
            timeout-ms = <80>;
        };

        zx_f7 {
            bindings = <&kp F7>;
            key-positions = <22 23>;
            timeout-ms = <80>;
        };

        xv_home {
            bindings = <&kp HOME>;
            key-positions = <23 25>;
            timeout-ms = <80>;
        };

        io_win_h {
            bindings = <&kp LG(H)>;
            key-positions = <11 13>;
            timeout-ms = <80>;
        };

        mj_delete {
            bindings = <&kp DELETE>;
            key-positions = <31 32>;
            timeout-ms = <80>;
        };

        dj_end {
            bindings = <&kp END>;
            key-positions = <30 32>;
            timeout-ms = <80>;
        };

        num_46_equal {
            bindings = <&kp UNDER>;
            key-positions = <18 20>;
            timeout-ms = <80>;
            layers = <NUM>;
        };

        num_78_multiply {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <6 7>;
            timeout-ms = <80>;
            layers = <NUM>;
        };

        num_89_divide {
            bindings = <&kp SLASH>;
            key-positions = <7 8>;
            timeout-ms = <80>;
            layers = <NUM>;
        };

        num_45_plus {
            bindings = <&kp COLON>;
            key-positions = <18 19>;
            timeout-ms = <80>;
            layers = <NUM>;
        };

        num_56_minus {
            bindings = <&kp MINUS>;
            key-positions = <19 20>;
            timeout-ms = <80>;
            layers = <NUM>;
        };

        f4 {
            bindings = <&kp F4>;
            key-positions = <32 33>;
            timeout-ms = <80>;
        };

        pageup {
            bindings = <&kp PAGE_UP>;
            key-positions = <34 41>;
        };
    };

    behaviors {
        pgdn_pgup: pgdn_pgup {
            compatible = "zmk,behavior-mod-morph";
            label = "PGDN_PGUP";
            bindings = <&kp PAGE_DOWN>, <&kp PAGE_UP>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layout {
            bindings = <
&kp Q           &kp L           &kp U        &kp COMMA  &kp DOT                                                 &kp F                  &kp W  &kp R  &kp Y  &kp P
&mt LCTRL E     &mt LEFT_ALT I  &kp A        &kp O      &kp MINUS         &kp PRINTSCREEN      &kp F15          &kp K                  &kp T  &kp N  &kp S  &mt RCTRL H
&mt LEFT_WIN Z  &kp X           &kp C        &kp V      &kp LEFT_BRACKET  &kp F2               &tog 6           &kp G                  &kp D  &kp M  &kp J  &mt LEFT_WIN B
&pgdn_pgup      &kp LS(HOME)    &kp LS(END)  &lt 1 TAB  &mt LSHIFT SPACE  &lt 3 ESCAPE         &lt 1 BACKSPACE  &mt RIGHT_SHIFT ENTER                       &lt 2 GRAVE
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        sign_num {
            bindings = <
&kp AT_SIGN    &kp LS(INT1)  &kp QUESTION     &kp UP_ARROW        &kp ASTERISK                                             &kp COMMA   &kp N7  &kp N8  &kp N9  &kp LS(NUMBER_4)
&kp SQT        &kp MINUS     &kp CARET        &kp LS(LEFT_ARROW)  &kp RIGHT_ARROW       &kp LS(ASTRK)      &kp UNDERSCORE  &kp N0      &kp N4  &kp N5  &kp N6  &kp LS(N5)
&kp HASH       &kp PLUS      &kp EXCLAMATION  &kp DOWN_ARROW      &kp LEFT_PARENTHESIS  &trans             &kp KP_NUMLOCK  &kp PERIOD  &kp N1  &kp N2  &kp N3  &kp INTERNATIONAL_3
&kp SEMICOLON  &kp EQUAL     &trans           &kp LG(D)           &kp LEFT_WIN          &trans             &trans          &trans                              &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        layer_bt_sel0_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                              &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans          &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans          &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &bt BT_CLR_ALL  &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        no {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans   &kp F7  &kp F8  &kp F9  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp F10  &kp F4  &kp F5  &kp F6  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans   &kp F1  &kp F2  &kp F3  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                           &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                              &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        arrow {
            bindings = <
&trans  &trans  &kp SPACE  &mmv MOVE_UP    &mkp MB1                             &trans        &kp LC(LEFT_ARROW)  &kp UP_ARROW      &kp LC(RIGHT_ARROW)  &trans
&trans  &trans  &trans     &mmv MOVE_LEFT  &mmv MOVE_RIGHT  &trans      &trans  &kp LC(PLUS)  &kp LEFT_ARROW      &mkp MB3          &kp RIGHT_ARROW      &trans
&trans  &trans  &trans     &mmv MOVE_DOWN  &mkp MB2         &trans      &trans  &trans        &kp LC(KP_MINUS)    &kp LC(UP_ARROW)  &kp DOWN_ARROW       &kp LC(DOWN_ARROW)
&trans  &trans  &trans     &trans          &trans           &trans      &trans  &trans                                                                   &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                              &trans
            >;
        };
    };
};
