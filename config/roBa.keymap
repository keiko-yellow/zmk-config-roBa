#include <behaviors.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/*
 * レイヤー番号
 *
 * 0 = default_layout
 * 1 = sign_num
 * 2 = layer_bt_sel0_4
 * 3 = no
 * 4 = mouse
 * 5 = arrow
 */
#define MOUSE 4
#define SCROLL 5
#define NUM 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    /*
     * トラックボールを動かす
     * → レイヤー4を有効化
     *
     * トラックボールを止める
     * → 650ms後にレイヤー4を解除
     *
     * MB1～MB5を出すために使用する物理キーだけは、
     * 押してもオートマウスレイヤーを解除しない。
     *
     * 6・7・8   = MB4 / MB5コンボに使用
     * 18・19・20 = MB1 / MB2 / MB3コンボに使用
     *
     * それ以外のキーを押すと、
     * クリック後であってもオートマウスレイヤーを即時解除する。
     */
    auto_mouse_layer: auto_mouse_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        excluded-positions = <6 7 8 18 19 20>;
    };

    combos {
        compatible = "zmk,combos";

        /*
         * 通常コンボはKeyball44と同じ80ms。
         * CV・DM・SHは認識しやすいようKeyball44と同じ140ms。
         */

        mb1 {
            bindings = <&mkp LCLK>;
            key-positions = <18 19>;
            timeout-ms = <80>;
        };

        mb2 {
            bindings = <&mkp RCLK>;
            key-positions = <20 19>;
            timeout-ms = <80>;
        };

        mb3 {
            bindings = <&mkp MB3>;
            key-positions = <18 20>;
            timeout-ms = <80>;
        };

        mb4 {
            bindings = <&mkp MB4>;
            key-positions = <6 7>;
            timeout-ms = <80>;
        };

        mb5 {
            bindings = <&mkp MB5>;
            key-positions = <7 8>;
            timeout-ms = <80>;
        };

        left {
            bindings = <&kp LEFT_ARROW>;
            key-positions = <11 12>;
            timeout-ms = <80>;
        };

        right {
            bindings = <&kp RIGHT_ARROW>;
            key-positions = <12 13>;
            timeout-ms = <80>;
        };

        up {
            bindings = <&kp UP_ARROW>;
            key-positions = <1 2>;
            timeout-ms = <80>;
        };

        down {
            bindings = <&kp DOWN_ARROW>;
            key-positions = <23 24>;
            timeout-ms = <80>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <1 0>;
            timeout-ms = <80>;
        };

        alt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <10 11>;
            timeout-ms = <80>;
        };

        del2 {
            bindings = <&kp DEL>;
            key-positions = <8 9>;
            timeout-ms = <80>;
        };

        /*
         * C + V → 左単語削除
         * Ctrl + Backspace
         */
        cv_ctrl_backspace {
            bindings = <&kp LC(BACKSPACE)>;
            key-positions = <24 25>;
            timeout-ms = <140>;
        };

        /*
         * D + M → 右単語削除
         * Ctrl + Delete
         */
        dm_ctrl_delete {
            bindings = <&kp LC(DELETE)>;
            key-positions = <30 31>;
            timeout-ms = <140>;
        };

        /*
         * S + H → 半角／全角
         *
         * 元設定で同じ20・21に存在したDeleteコンボは削除し、
         * 競合しないようにしている。
         */
        hankaku {
            bindings = <&kp LANG_ZENKAKUHANKAKU>;
            key-positions = <20 21>;
            timeout-ms = <140>;
        };

        f4 {
            bindings = <&kp F4>;
            key-positions = <32 33>;
            timeout-ms = <80>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * Layer 0
         * 現在のroBa通常レイヤーを変更しない。
         */
        default_layout {
            bindings = <
                &kp Q                  &kp L                   &kp U                   &kp COMMA               &kp DOT
                &kp F                  &kp W                   &kp R                   &kp Y                   &kp P

                &mt LCTRL E            &mt LEFT_ALT I          &kp A                   &kp O                   &kp MINUS
                &kp F7                 &kp LANGUAGE_1          &kp K                   &kp T                   &kp N
                &kp S                  &mt RCTRL H

                &mt LEFT_WIN Z         &kp X                   &kp C                   &kp V                   &kp LEFT_BRACKET
                &kp F10                &kp LANG2               &kp G                   &kp D                   &kp M
                &kp J                  &mt LEFT_WIN B

                &kp LEFT_ALT           &kp HOME                &kp END                 &lt 1 TAB               &mt LSHIFT SPACE
                &lt 3 ESCAPE           &lt 1 BACKSPACE         &mt RIGHT_SHIFT ENTER   &lt 2 F15
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        /*
         * Layer 1
         */
        sign_num {
            bindings = <
                &kp POUND              &kp EXCLAMATION         &kp CARET               &kp ASTERISK            &kp LEFT_PARENTHESIS
                &kp KP_COMMA           &kp N7                  &kp N8                  &kp N9                  &kp LS(NUMBER_4)

                &kp AT_SIGN            &kp QUESTION            &kp UNDER               &kp LS(DOUBLE_QUOTES)   &kp SLASH
                &kp LS(ASTRK)          &kp KP_NUMLOCK          &kp N0                  &kp N4                  &kp N5
                &kp N6                 &kp LS(N5)

                &kp APOS               &kp PLUS                &none                   &kp COLON               &kp MINUS
                &trans                 &none                   &kp PERIOD              &kp N1                  &kp N2
                &kp N3                 &trans

                &trans                 &trans                  &trans                  &kp LG(D)               &kp LEFT_WIN
                &trans                 &trans                  &trans                  &trans
            >;
        };

        /*
         * Layer 2
         */
        layer_bt_sel0_4 {
            bindings = <
                &trans                 &trans                  &trans                  &trans                  &trans
                &bt BT_SEL 0           &bt BT_SEL 1            &bt BT_SEL 2            &bt BT_SEL 3            &bt BT_SEL 4

                &trans                 &trans                  &trans                  &trans                  &trans
                &trans                 &trans                  &bt BT_SEL 0            &bt BT_SEL 4            &trans
                &trans                 &trans

                &trans                 &trans                  &trans                  &trans                  &trans
                &trans                 &trans                  &trans                  &bt BT_SEL 1            &bt BT_SEL 2
                &bt BT_SEL 3           &trans

                &trans                 &trans                  &trans                  &trans                  &trans
                &trans                 &bt BT_CLR_ALL          &trans
            >;
        };

        /*
         * Layer 3
         */
        no {
            bindings = <
                &trans                 &trans                  &trans                  &trans                  &trans
                &trans                 &kp F7                  &kp F8                  &kp F9                  &trans

                &trans                 &trans                  &trans                  &trans                  &trans
                &trans                 &trans                  &kp F10                 &kp F4                  &kp F5
                &kp F6                 &trans

                &trans                 &trans                  &trans                  &trans                  &trans
                &trans                 &trans                  &trans                  &kp F1                  &kp F2
                &kp F3                 &trans

                &trans                 &trans                  &trans                  &trans                  &trans
                &trans                 &trans                  &trans                  &trans
            >;
        };

        /*
         * Layer 4
         * オートマウスレイヤー
         */
        mouse {
            bindings = <
                &trans                 &trans                  &trans                  &trans                  &trans
                &trans                 &trans                  &trans                  &trans                  &trans

                &trans                 &trans                  &trans                  &trans                  &trans
                &trans                 &trans                  &trans                  &mkp MB1                &mkp MB2
                &trans                 &trans

                &trans                 &trans                  &trans                  &trans                  &trans
                &trans                 &trans                  &trans                  &trans                  &trans
                &trans                 &trans

                &trans                 &trans                  &trans                  &trans                  &trans
                &trans                 &trans                  &trans                  &trans
            >;
        };

        /*
         * Layer 5
         */
        arrow {
            bindings = <
                &trans                 &trans                  &trans                  &trans                  &trans
                &trans                 &kp LC(LEFT_ARROW)      &kp UP_ARROW            &kp LC(RIGHT_ARROW)     &trans

                &trans                 &trans                  &trans                  &trans                  &trans
                &trans                 &trans                  &kp LC(PLUS)            &kp LEFT_ARROW          &mkp MB3
                &kp RIGHT_ARROW        &trans

                &trans                 &trans                  &trans                  &trans                  &trans
                &trans                 &trans                  &trans                  &kp LC(KP_MINUS)        &kp LC(UP_ARROW)
                &kp DOWN_ARROW         &kp LC(DOWN_ARROW)

                &trans                 &trans                  &trans                  &trans                  &trans
                &trans                 &trans                  &trans                  &trans
            >;
        };
    };

    /*
     * 通常時：
     * トラックボール操作でMOUSEレイヤー（4）を一時的に有効化する。
     * 最後のトラックボール入力から650ms後に自動解除する。
     *
     * MB1～MB5以外の物理キーを押した場合は、
     * 650msを待たずに即時解除する。
     *
     * sign_num（レイヤー1）を有効にしている間：
     * トラックボールのX/Y移動を横・縦スクロールへ変換する。
     * sign_numは現在の &lt 1 TAB または &lt 1 BACKSPACE の
     * 長押しで有効になる。
     */
    trackball_listener {
        status = "okay";

        input-processors = <&auto_mouse_layer MOUSE 650>;

        sign_num_scroll {
            layers = <1>;
            input-processors = <
                &zip_xy_to_scroll_mapper
                &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
                &zip_scroll_scaler 1 8
            >;
        };
    };
};
