#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/*
 * レイヤー番号
 *
 * 0 = default_layout   現在のroBa通常レイヤー（変更なし）
 * 1 = sign_num        現在のroBa数字・記号レイヤー
 * 2 = layer_bt_sel0_4 Bluetooth
 * 3 = no              Fキー
 * 4 = mouse           オートマウス
 * 5 = arrow           矢印・編集
 */
#define BASE 0
#define SIGN_NUM 1
#define BT_LAYER 2
#define FN_LAYER 3
#define MOUSE 4
#define ARROW 5

/*
 * 現在のroBaのMod-Tap設定を維持。
 * 通常レイヤーの文字配置・長押しキーは変更しない。
 */
&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    /*
     * トラックボールを動かしたとき、一時的にMOUSEレイヤーを有効化。
     *
     * Keyball44側:
     * AUTO_MOUSE_LAYER_KEEP_TIME = 30000
     *
     * excluded-positions:
     * 18 = T位置（MOUSEレイヤーでは左クリック）
     * 19 = N位置（MOUSEレイヤーでは右クリック）
     *
     * マウスボタンを押しても、オートマウスレイヤーを即解除しない。
     */
    auto_mouse_layer: auto_mouse_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        excluded-positions = <18 19>;
    };

    combos {
        compatible = "zmk,combos";

        /*
         * Keyball44と同じコンボ。
         *
         * 通常の判定時間: 80ms
         * 効きにくかった7コンボ: 140ms
         *
         * コンボはroBaの物理番号ではなく、
         * 現在のroBa通常レイヤー上の文字位置に合わせている。
         */

        /* Q + L -> Esc（長め140ms） */
        combo_ql_esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
            timeout-ms = <140>;
            layers = <BASE>;
        };

        /* L + U -> 上 */
        combo_lu_up {
            bindings = <&kp UP_ARROW>;
            key-positions = <1 2>;
            timeout-ms = <80>;
            layers = <BASE>;
        };

        /* X + C -> 下 */
        combo_xc_down {
            bindings = <&kp DOWN_ARROW>;
            key-positions = <23 24>;
            timeout-ms = <80>;
            layers = <BASE>;
        };

        /* I + A -> 左 */
        combo_ia_left {
            bindings = <&kp LEFT_ARROW>;
            key-positions = <11 12>;
            timeout-ms = <80>;
            layers = <BASE>;
        };

        /* A + O -> 右 */
        combo_ao_right {
            bindings = <&kp RIGHT_ARROW>;
            key-positions = <12 13>;
            timeout-ms = <80>;
            layers = <BASE>;
        };

        /* C + V -> 左単語削除（Ctrl + Backspace、長め140ms） */
        combo_cv_ctrl_backspace {
            bindings = <&kp LC(BACKSPACE)>;
            key-positions = <24 25>;
            timeout-ms = <140>;
            layers = <BASE>;
        };

        /* D + M -> 右単語削除（Ctrl + Delete、長め140ms） */
        combo_dm_ctrl_delete {
            bindings = <&kp LC(DELETE)>;
            key-positions = <30 31>;
            timeout-ms = <140>;
            layers = <BASE>;
        };

        /* M + J -> Delete（長め140ms） */
        combo_mj_delete {
            bindings = <&kp DELETE>;
            key-positions = <31 32>;
            timeout-ms = <140>;
            layers = <BASE>;
        };

        /* W + R -> 戻る */
        combo_wr_back {
            bindings = <&mkp MB4>;
            key-positions = <6 7>;
            timeout-ms = <80>;
            layers = <BASE>;
        };

        /* R + Y -> 進む */
        combo_ry_forward {
            bindings = <&mkp MB5>;
            key-positions = <7 8>;
            timeout-ms = <80>;
            layers = <BASE>;
        };

        /* T + S -> Esc（長め140ms） */
        combo_ts_esc {
            bindings = <&kp ESC>;
            key-positions = <18 20>;
            timeout-ms = <140>;
            layers = <BASE>;
        };

        /* S + H -> 半角／全角（長め140ms） */
        combo_sh_hankaku {
            bindings = <&kp LANG_ZENKAKUHANKAKU>;
            key-positions = <20 21>;
            timeout-ms = <140>;
            layers = <BASE>;
        };

        /* E + I -> F10（長め140ms） */
        combo_ei_f10 {
            bindings = <&kp F10>;
            key-positions = <10 11>;
            timeout-ms = <140>;
            layers = <BASE>;
        };

        /* Z + X -> F7 */
        combo_zx_f7 {
            bindings = <&kp F7>;
            key-positions = <22 23>;
            timeout-ms = <80>;
            layers = <BASE>;
        };

        /* X + V -> Home */
        combo_xv_home {
            bindings = <&kp HOME>;
            key-positions = <23 25>;
            timeout-ms = <80>;
            layers = <BASE>;
        };

        /* D + J -> End */
        combo_dj_end {
            bindings = <&kp END>;
            key-positions = <30 32>;
            timeout-ms = <80>;
            layers = <BASE>;
        };

        /* I + O -> Windows音声入力（Win + H） */
        combo_io_win_h {
            bindings = <&kp LG(H)>;
            key-positions = <11 13>;
            timeout-ms = <80>;
            layers = <BASE>;
        };

        /*
         * MOUSEレイヤー:
         * 左クリック位置 + 右クリック位置 -> 中クリック
         */
        combo_lclk_rclk_mclk {
            bindings = <&mkp MB3>;
            key-positions = <18 19>;
            timeout-ms = <80>;
            layers = <MOUSE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * Layer 0
         *
         * 現在のroBa設定をそのまま維持。
         * 文字配置・Mod-Tap・親指キーは変更していない。
         */
        default_layout {
            bindings = <
                &kp Q                 &kp L                 &kp U                  &kp COMMA              &kp DOT
                &kp F                 &kp W                 &kp R                  &kp Y                  &kp P

                &mt LCTRL E           &mt I LEFT_ALT        &kp A                  &kp O                  &kp MINUS
                &kp F7                &kp LANGUAGE_1        &kp K                  &kp T                  &kp N
                &kp S                 &mt RCTRL H

                &mt LEFT_WIN Z        &kp X                 &kp C                  &kp V                  &kp LEFT_BRACKET
                &kp F10               &kp LANG2             &kp G                  &kp D                  &kp M
                &kp J                 &mt B LEFT_WIN

                &kp LEFT_ALT          &kp HOME              &kp END                &lt SIGN_NUM TAB       &mt LSHIFT SPACE
                &lt FN_LAYER ESCAPE   &lt SIGN_NUM BACKSPACE &mt RIGHT_SHIFT ENTER &lt BT_LAYER F15
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        /*
         * Layer 1
         *
         * 現在のroBa数字・記号レイヤーを維持。
         */
        sign_num {
            bindings = <
                &kp POUND             &kp EXCLAMATION       &kp CARET              &kp ASTERISK           &kp LEFT_PARENTHESIS
                &kp KP_COMMA          &kp N7                &kp N8                 &kp N9                 &kp LS(NUMBER_4)

                &kp AT_SIGN           &kp QUESTION          &kp UNDER              &kp LS(DOUBLE_QUOTES)  &kp SLASH
                &kp LS(ASTRK)         &kp KP_NUMLOCK        &kp N0                 &kp N4                 &kp N5
                &kp N6                &kp LS(N5)

                &kp APOS              &kp PLUS              &none                  &kp COLON              &kp MINUS
                &trans                &none                  &kp PERIOD             &kp N1                 &kp N2
                &kp N3                &trans

                &trans                &trans                &trans                 &kp LG(D)              &kp LEFT_WIN
                &trans                &trans                &trans                 &trans
            >;
        };

        /*
         * Layer 2
         *
         * Bluetooth設定はroBa固有のため維持。
         */
        layer_bt_sel0_4 {
            bindings = <
                &trans                &trans                &trans                 &trans                 &trans
                &bt BT_SEL 0          &bt BT_SEL 1          &bt BT_SEL 2           &bt BT_SEL 3           &bt BT_SEL 4

                &trans                &trans                &trans                 &trans                 &trans
                &trans                &trans                &bt BT_SEL 0           &bt BT_SEL 4           &trans
                &trans                &trans

                &trans                &trans                &trans                 &trans                 &trans
                &trans                &trans                &trans                 &bt BT_SEL 1           &bt BT_SEL 2
                &bt BT_SEL 3          &trans

                &trans                &trans                &trans                 &trans                 &trans
                &trans                &bt BT_CLR_ALL        &trans
            >;
        };

        /*
         * Layer 3
         *
         * 現在のroBa Fキーレイヤーを維持。
         */
        no {
            bindings = <
                &trans                &trans                &trans                 &trans                 &trans
                &trans                &kp F7                &kp F8                 &kp F9                 &trans

                &trans                &trans                &trans                 &trans                 &trans
                &trans                &trans                &kp F10                &kp F4                 &kp F5
                &kp F6                &trans

                &trans                &trans                &trans                 &trans                 &trans
                &trans                &trans                &trans                 &kp F1                 &kp F2
                &kp F3                &trans

                &trans                &trans                &trans                 &trans                 &trans
                &trans                &trans                &trans                 &trans
            >;
        };

        /*
         * Layer 4
         *
         * Keyball44のオートマウス操作に合わせ、
         * T位置を左クリック、N位置を右クリックにする。
         * 2キー同時押しは上のコンボにより中クリック。
         */
        mouse {
            bindings = <
                &trans                &trans                &trans                 &trans                 &trans
                &trans                &trans                &trans                 &trans                 &trans

                &trans                &trans                &trans                 &trans                 &trans
                &trans                &trans                &trans                 &mkp LCLK              &mkp RCLK
                &trans                &trans

                &trans                &trans                &trans                 &trans                 &trans
                &trans                &trans                &trans                 &trans                 &trans
                &trans                &trans

                &trans                &trans                &trans                 &trans                 &trans
                &trans                &trans                &trans                 &trans
            >;
        };

        /*
         * Layer 5
         *
         * 現在のroBa矢印・編集レイヤーを維持。
         */
        arrow {
            bindings = <
                &trans                &trans                &trans                 &trans                 &trans
                &trans                &kp LC(LEFT_ARROW)    &kp UP_ARROW           &kp LC(RIGHT_ARROW)    &trans

                &trans                &trans                &trans                 &trans                 &trans
                &trans                &trans                &kp LC(PLUS)           &kp LEFT_ARROW         &mkp MB3
                &kp RIGHT_ARROW       &trans

                &trans                &trans                &trans                 &trans                 &trans
                &trans                &trans                &kp LC(KP_MINUS)       &kp LC(UP_ARROW)       &kp DOWN_ARROW
                &kp LC(DOWN_ARROW)    &trans

                &trans                &trans                &trans                 &trans                 &trans
                &trans                &trans                &trans                 &trans
            >;
        };
    };

    /*
     * Keyball44:
     * AUTO_MOUSE_LAYER_KEEP_TIME = 30000
     *
     * 最後のトラックボール入力から30秒間、
     * MOUSEレイヤーを維持する。
     */
    trackball_listener {
        status = "okay";
        input-processors = <&auto_mouse_layer MOUSE 30000>;
    };
};
